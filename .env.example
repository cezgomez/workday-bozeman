# Required unless you pass --config on the CLI every run
WORKDAY_CONFIG=assets/credentials/preview-configuration.json

# Optional field-level overrides (leave blank to use the config file)
# WORKDAY_USERNAME=
# WORKDAY_PASSWORD=
# WORKDAY_TENANT=
# WORKDAY_DOMAIN=
# WORKDAY_REPORT_URL=
# WORKDAY_WORKERS_REPORT_URL=
# WORKDAY_WORKER_WID=
# WORKDAY_BLOBITORY_USERNAME=
# WORKDAY_BLOBITORY_PASSWORD=
# WORKDAY_BLOBITORY_HOST=
# WORKDAY_STAFFING_USERNAME=
# WORKDAY_STAFFING_PASSWORD=
# WORKDAY_STAFFING_URL=

# Optional SFTP overrides
# SFTP_HOST=
# SFTP_PORT=
# SFTP_USERNAME=
# SFTP_PASSWORD=
# SFTP_REMOTE_ROOT=
# Concurrent SFTP connections (1–3, default 3)
# SFTP_POOL_SIZE=3
